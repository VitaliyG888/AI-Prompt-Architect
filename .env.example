# ── AI Prompt Architect ────────────────────────────────────────────────
# Скопируйте в .env и заполните при необходимости. Все значения опциональны:
# провайдеры и поисковые сервисы настраиваются через интерфейс Settings.

# Порт и адрес локального сервера
PORT=4319
HOST=127.0.0.1

# Каталог данных (SQLite, мастер-ключ, бэкапы)
# APP_DATA_DIR=./data

# Мастер-ключ шифрования API-ключей: 32 байта в base64 или hex.
# Если не задан — будет сгенерирован в data/master.key (chmod 600).
# APP_MASTER_KEY=

# Разрешить провайдеров на loopback/приватных адресах (локальные LLM-шлюзы).
# По умолчанию запрещено (защита от SSRF).
# ALLOW_PRIVATE_PROVIDERS=0

# Токен доступа, если приложение открывается не только с localhost.
# APP_TOKEN=

# Ограничение размера контекста, передаваемого в LLM (символов).
# MAX_CONTEXT_CHARS=24000
